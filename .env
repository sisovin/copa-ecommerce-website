# Environment variables for Copa E-Commerce Website

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=copa_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/copa_db?schema=public

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# NestJS
NEST_PORT=3000
